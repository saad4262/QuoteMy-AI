# Copy to .env and fill in.  cp .env.example .env
#
# .env is gitignored (the root .gitignore matches .env at any depth) - check that before adding
# anything real to it.

# The shared secret between the app and this stack. The app sends it as X-Telemetry-Key; the gate
# refuses anything without it. Generate one:
#
#   openssl rand -hex 32
#
# The SAME value goes into Vercel's environment variables as TELEMETRY_SECRET.
TELEMETRY_SECRET=

# Grafana login at http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
