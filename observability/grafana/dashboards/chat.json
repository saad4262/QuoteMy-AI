        }
      }
    },
    {
      "type": "timeseries",
      "title": "Customers asking their own questions",
      "description": "Pictures cost about a tenth of a cent each; a rates question costs cents. Both are capped per conversation.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=\"quotemy-api\", env=~\"$env\"} |= `looked up pictures` [$__auto]))",
          "legendFormat": "pictures",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range"
        },
        {
          "refId": "B",
          "expr": "sum(count_over_time({service=\"quotemy-api\", env=~\"$env\"} | json | msg=`voice turn` [$__auto]))",
          "legendFormat": "voice turns",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
