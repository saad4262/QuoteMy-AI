rules_version = '2';

// Security rules for the services onboarding path.
//
// These are not defence in depth here - they are THE defence. This service runs with no auth of
// its own and the frontend writes to Firestore directly, so what a signed-in business can and
// cannot write is decided entirely by this file.
//
// The Admin SDK ignores rules, which is why the Node service can write the documents below that
// every client is forbidden from touching.
//
// Merge this into your existing firestore.rules - it only covers businesses/{uid}/services/**.

service cloud.firestore {
  match /databases/{database}/documents {

    match /businesses/{uid}/services/{trade} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow read: if isOwner();
      // The frontend stamps lastSubmittedAt on save; the trade root holds nothing sensitive.
      allow write: if isOwner();

      // The business's own words and files. Theirs to write, and the one thing that must survive
      // whatever the AI later decides.
      match /description/raw {
        allow read: if isOwner();
        allow create, update: if isOwner();
        allow delete: if false;
      }

      // Our answer. The business may only flip displayState to "pending" while waiting - it may
      // never write the review body, or it could approve itself.
      match /description/lastaireview {
        allow read: if isOwner();
        allow create, update: if isOwner()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['displayState', 'updatedAt'])
          && request.resource.data.displayState == 'pending';
        allow delete: if false;
      }

      // What customers search. Written by the service only. A business that could write this could
      // publish any price it liked, with an "approved" stamp on it, and the entire review pipeline
      // would be decorative.
      match /jsondata/extracted {
        allow read: if isOwner();
        // The frontend creates an empty stub once; after that only the server writes.
        allow create: if isOwner()
          && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
          && request.resource.data.data == null;
        allow update, delete: if false;
      }

      // Review history, for the admin view.
      match /submissions/{submissionId} {
        allow read: if isOwner();
        allow write: if false;
      }
    }

    // The finished quote for one customer, so their results page can listen for it. Written only by
    // this service.
    //
    // Readable without auth on purpose: a customer asking for a quote has not signed in, and asking
    // them to before they can see it would lose the job. The id is what protects the document - a
    // UUID this service generates, never anything a caller sent. It carries business names, real
    // prices, the customer's suburb and whatever they were quoted elsewhere, so an id anyone could
    // guess would hand all of that to them.
    //
    // If that trade ever stops being acceptable, the fix is to key these by the Firebase Auth uid
    // and require a signed-in customer - not to add a rule here, which cannot tell the difference.
    match /quoteResults/{resultId} {
      allow read: if true;
      allow write: if false;
    }

    // What the customer chat has spent today. The service's own bookkeeping; nobody else reads or
    // writes it, and a client that could would be able to talk us past our own ceiling.
    match /chatSpend/{day} {
      allow read, write: if false;
    }

    // The trade vocabulary and checklist the chat is built from. Read by the service with the Admin
    // SDK, which ignores these rules; no client has any business touching it.
    match /schema/{trade} {
      allow read, write: if false;
    }
  }
}
