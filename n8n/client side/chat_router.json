        "jsCode": "const dispatched = $('Dispatch by Trade').first()?.json || {};\nconst result = $input.first()?.json || {};\n\nif (!result || !result.type) {\n  return [{\n    json: {\n      sessionId: result.sessionId || dispatched.sessionId || null,\n      trade: result.trade || dispatched.trade || '',\n      type: 'message',\n      message: 'Sorry, something went wrong on my end — mind trying that again in a moment?',\n      options: [],\n      checklistComplete: false,\n      checklist: null,\n      results: [],\n    },\n  }];\n}\n\nreturn [{ json: { ...result, trade: result.trade || dispatched.trade || '' } }];\n"
      },
