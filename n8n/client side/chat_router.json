    {
      "parameters": {
        "jsCode": "// The fencing conversation builds every question and every multiple choice out of\n// /schema/fencing — the materials, the site conditions, the gate types, and the wording that\n// goes with them. That makes it needed on every single turn, while it only actually changes\n// when a business registers something new, which is rare. A document read per message for data\n// that is identical all day is not worth paying for, so it is fetched once and kept here.\nconst TTL_MS = 60 * 60 * 1000;\nconst item = $input.first().json;\nconst trade = String(item.trade || '').toLowerCase().trim();\n\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.schema) staticData.schema = {};\nconst cached = staticData.schema[trade];\nconst fresh = !!(\n  cached &&\n  cached.json &&\n  Number.isFinite(Number(cached.fetchedAt)) &&\n  Date.now() - Number(cached.fetchedAt) < TTL_MS\n);\n\nreturn [{ json: { ...item, schemaJson: fresh ? cached.json : '', schemaFresh: fresh } }];"
      },
