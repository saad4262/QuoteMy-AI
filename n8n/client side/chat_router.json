        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'gpt-4o-mini',\n  response_format: { type: 'json_object' },\n  max_tokens: 60,\n  temperature: 0,\n  messages: [\n    { role: 'system', content: 'You classify a home-improvement enquiry into one trade. Valid trades: fencing, tiling, retaining-wall, decking. Reply with raw JSON only: {\"trade\":\"fencing\"|\"tiling\"|\"retaining-wall\"|\"decking\"|null}. Return null whenever you are not confident, when the enquiry names neither trade, or when it names more than one — a wrong guess sends the customer into the wrong questionnaire and they have to start over, which is far worse than one extra question.' },\n    { role: 'user', content: String($json.message || '').slice(0, 600) + ($json.extractedText ? '\\n\\n--- attached document ---\\n' + String($json.extractedText).slice(0, 1200) : '') }\n  ]\n}) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "a87a0c4b-b27a-4bc5-a381-75c5f7235964",
      "name": "Classify Trade",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -880,
        1616
      ],
