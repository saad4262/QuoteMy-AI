    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst FIELD_OWNERS = {\n  fencing: ['fenceType', 'lengthMeters', 'heightMm', 'removeOldFence', 'siteAccess'],\n  tiling: ['surface', 'room', 'floorAreaSqm', 'wallAreaSqm', 'removeOldTiles', 'substrate', 'tileSize', 'pattern'],\n  'retaining-wall': ['wallType', 'lengthMeters', 'heightBand', 'removeOldWall', 'siteAccess'],\n  decking: ['material', 'areaSqm', 'deckHeight', 'needsBalustrade', 'balustradeLm', 'needsStairs', 'stairFlights'],\n};\n\nlet known = {};\ntry { known = JSON.parse(item.knownChecklist || '{}') || {}; } catch (error) { known = {}; }\n\nconst answered = Object.keys(known).filter((key) => known[key] !== null && known[key] !== undefined && known[key] !== '');\nconst byField = Object.keys(FIELD_OWNERS).filter((trade) =>\n  FIELD_OWNERS[trade].some((field) => answered.includes(field)),\n);\nif (byField.length === 1) {\n  return [{ json: { ...item, trade: byField[0], resolvedBy: 'checklist' } }];\n}\n\nconst haystack = [item.message || '', item.extractedText || ''].join(' ');\n\nconst TRADE_HINTS = [\n  ['fencing', /fenc\\w*|paling|colou?rbond|chainmesh|chain ?wire|boundary fence|pool fence/i],\n  ['tiling', /til(?:e|es|ing|er)\\b|splashback|splash back|grout|waterproof\\w*|mosaic|porcelain/i],\n  ['retaining-wall', /retaining|retain(?:ing)?\\s*wall|sleeper wall|concrete sleeper|besser block/i],\n  ['decking', /deck(?:ing)?\\b|merbau deck|composite deck|balustrade|deck stairs|spotted gum deck/i],\n];\n\nconst hits = TRADE_HINTS.filter(([, pattern]) => pattern.test(haystack)).map(([trade]) => trade);\n\nreturn [{\n  json: {\n    ...item,\n    trade: hits.length === 1 ? hits[0] : '',\n    resolvedBy: hits.length === 1 ? 'keyword' : 'needsModel',\n  },\n}];"
      },
