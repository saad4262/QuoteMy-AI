    {
      "parameters": {
        "jsCode": "const source = $('Resolve Trade').first().json;\nconst response = $input.first().json || {};\n\nlet trade = null;\ntry {\n  const raw = response.choices?.[0]?.message?.content || '';\n  const parsed = JSON.parse(String(raw).replace(/```json|```/g, '').trim());\n  const candidate = String(parsed.trade || '').toLowerCase().trim();\n  trade = ['fencing', 'tiling', 'retaining-wall', 'decking'].includes(candidate) ? candidate : null;\n} catch (error) {\n  trade = null;\n}\n\nreturn [{ json: { ...source, trade: trade || '', resolvedBy: trade ? 'model' : 'unresolved' } }];"
      },
