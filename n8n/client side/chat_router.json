    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst source = $('Normalize Input').first().json;\nconst binaryKeys = Object.keys(item.binary || {});\nconst base = {\n  message: source.message,\n  sessionId: source.sessionId,\n  trade: String(source.trade || '').trim(),\n  place: source.place || '',\n  knownChecklist: source.knownChecklist || '',\n};\n\nif (binaryKeys.length === 0) {\n  return [{ json: base }];\n}\n\nreturn binaryKeys.map((key) => {\n  const meta = item.binary[key];\n  return {\n    json: { ...base, mimeType: meta.mimeType },\n    binary: { data: meta },\n  };\n});"
      },
