    {
      "parameters": {
        "jsCode": "const source = $('Normalize Input').first().json;\nconst current = $input.first().json;\n\nconst combined = current.combinedExtractedText;\nconst documents = (Array.isArray(combined) ? combined : [current.text || current.data || current.content || ''])\n  .map((entry) => String(entry === null || entry === undefined ? '' : entry).trim())\n  .filter(Boolean);\n\nconst extractedText = (\n  documents.length > 1\n    ? documents.map((text, index) => `--- Document ${index + 1} of ${documents.length} ---\\n${text}`).join('\\n\\n')\n    : documents[0] || ''\n).slice(0, 4000);\n\nreturn [{\n  json: {\n    message: source.message,\n    sessionId: source.sessionId,\n    trade: String(source.trade || '').trim(),\n    place: source.place || '',\n    knownChecklist: source.knownChecklist || '',\n    extractedText,\n    extractionFailed: Array.isArray(combined) && documents.length === 0,\n  },\n}];"
      },
