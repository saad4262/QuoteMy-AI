    {
      "parameters": {
        "jsCode": "const TTL_MS = 60 * 60 * 1000;\nconst source = $('Read Schema Cache').first().json;\nconst trade = String(source.trade || '').toLowerCase().trim();\nconst document = $input.first().json || {};\n\n// A Firestore hiccup must not take the conversation down with it. The subagent carries its own\n// copy of the vocabulary for exactly this case, and an empty string is how it is told to fall\n// back to it — the conversation degrades to slightly worse wording rather than to nothing.\nconst usable = !!(document && !document.error && document.core && typeof document.core === 'object');\nconst schemaJson = usable\n  ? JSON.stringify({\n      core: document.core || {},\n      labels: document.labels || {},\n      questions: document.questions || {},\n      extras: document.extras || {},\n    })\n  : '';\n\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.schema) staticData.schema = {};\n// Only a real read is worth remembering. Caching the failure would keep the fallback in place\n// for a full hour after Firestore came back.\nif (schemaJson) staticData.schema[trade] = { json: schemaJson, fetchedAt: Date.now() };\n\nreturn [{ json: { ...source, schemaJson, schemaFresh: false } }];"
      },
