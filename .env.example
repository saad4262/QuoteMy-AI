# --- server ---
PORT=8787
NODE_ENV=development
LOG_LEVEL=info
# comma-separated list, or * for any (development only)
CORS_ORIGINS=*
# single-stage routes under /api/v1/dev - prompt tuning only, never on in production
ENABLE_DEV_ROUTES=true

# --- model ---
# mock   = deterministic offline reader, no API key, no spend (use this for Postman testing)
# openai = the real thing
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
MODEL_TIMEOUT_MS=45000
MAX_COST_PER_REQUEST_USD=0.5

# --- input limits ---
MIN_TEXT_CHARS=40
MAX_TEXT_CHARS=60000

# --- persistence ---
# memory    = in-process (tests, Postman). firestore = production; the frontend writes first.
STORE=memory
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

# Sweeper. Requires STORE=firestore. Picks up queued work if the HTTP nudge never arrives.
WORKER_ENABLED=false
WORKER_INTERVAL_MS=120000
WORKER_MAX_ATTEMPTS=3
WORKER_STALE_MS=600000
WORKER_BATCH=5



