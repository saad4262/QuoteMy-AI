# --- server ---
PORT=8787
NODE_ENV=development
LOG_LEVEL=info
# comma-separated list, or * for any (development only)
CORS_ORIGINS=*
# single-stage routes under /api/v1/dev - prompt tuning only, never on in production
ENABLE_DEV_ROUTES=true

# --- model ---
# mock   = deterministic offline reader, no API key, no spend (use this for Postman testing)
# openai = the real thing
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
MODEL_TIMEOUT_MS=45000

# Resolves serviceArea.baseLocation ("Berwick") to a point so customer matching can work by
# distance. Unset means the field stays null - never a guessed coordinate.
GEOCODING_API_KEY=
MAX_COST_PER_REQUEST_USD=0.5

# Answers questions the CUSTOMER asks ("is Colorbond better than timber", "what's it going for")
# from a live web search, alongside the checklist question. Needs AI_PROVIDER=openai; under the
# mock provider it returns a canned line and searches nothing.
#
# Its own switch because it is the one part of a chat turn that costs cents rather than fractions
# of one: roughly $0.05-$0.08 a question against $0.0003 for an ordinary turn, and 8-16 seconds
# instead of 1-2. Capped at six questions a conversation and two searches an answer, and it pays
# into MAX_CHAT_SPEND_PER_DAY_USD like everything else. Set false and the conversation still runs -
# the question simply goes unanswered, which is how it behaved before this existed.
ANSWER_QUESTIONS=true

# --- voice ---
# Both unset = the voice endpoints still work for Postman; only speech needs them.
# The key stays server-side. It must never be sent to a browser.
RETELL_API_KEY=
RETELL_AGENT_ID=

# --- input limits ---
MIN_TEXT_CHARS=40
MAX_TEXT_CHARS=60000

# --- persistence ---
# memory    = in-process (tests, Postman). firestore = production; the frontend writes first.
STORE=memory
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
# Serverless hosts (Vercel) have no writable disk, so the key cannot be a file there.
# Same JSON, base64 encoded:  base64 -i serviceAccount.json
FIREBASE_SERVICE_ACCOUNT_B64=

# Sweeper. Requires STORE=firestore. Picks up queued work if the HTTP nudge never arrives.
# On a serverless host the sweeper runs as a scheduled request to /api/cron instead of an
# interval, and CRON_SECRET is what stops anyone else from calling it.
CRON_SECRET=

WORKER_ENABLED=false
WORKER_INTERVAL_MS=120000
WORKER_MAX_ATTEMPTS=3
WORKER_STALE_MS=600000
WORKER_BATCH=5



