rules_version = '2';

// A business writes only under its own folder. The Node service reads these files through the
// Admin SDK by path, which ignores these rules - so nothing here needs to be readable publicly.

service firebase.storage {
  match /b/{bucket}/o {
    match /businesses/{uid}/services/{trade}/{submissionId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 20 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
